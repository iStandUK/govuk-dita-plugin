<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE bookmap PUBLIC "-//OASIS//DTD DITA BookMap//EN" "bookmap.dtd">
<bookmap id="govuk-dita-plugin-manual" xml:lang="en-GB">
  <booktitle>
    <mainbooktitle>GOV.UK DITA plugin manual</mainbooktitle>
    <booktitlealt>How to install and use org.istanduk.gov-uk, the DITA Open Toolkit plugin
      that publishes DITA content as a self-contained static website styled with the GOV.UK
      Design System. This manual is itself a DITA publication built with the plugin, so every
      page doubles as a demonstration of the output.</booktitlealt>
  </booktitle>
  <bookmeta>
    <author>iStandUK</author>
    <!-- The print document's cover shows these (#150). The edition is the plugin
         release the manual describes and the revised date is that release's; both
         move with the version bump (docs/RELEASING.md), and CI checks the edition
         against plugin.xml. -->
    <critdates>
      <created date="2026-09-01"/>
      <revised modified="2026-10-04"/>
    </critdates>
    <bookid>
      <edition>Version 1.2.0</edition>
    </bookid>
    <bookrights>
      <copyrfirst><year>2026</year></copyrfirst>
      <bookowner>
        <organization>iStandUK</organization>
      </bookowner>
    </bookrights>
  </bookmeta>
  <frontmatter>
    <booklists>
      <toc/>
      <figurelist/>
      <tablelist/>
    </booklists>
    <preface keyref="preface"/>
  </frontmatter>
  <chapter>
    <topicmeta>
      <navtitle>Getting started</navtitle>
      <shortdesc>What the plugin is, how to install it, and how to build your first site.</shortdesc>
    </topicmeta>
    <mapref href="keys.ditamap" processing-role="resource-only"/>
    <topicref keyref="introduction"/>
    <topicref keyref="install"/>
    <topicref keyref="build"/>
  </chapter>
  <chapter>
    <topicmeta>
      <navtitle>Reference</navtitle>
      <shortdesc>Build parameters, branding and the legal position, your own stylesheet, navigation, search, printing, security, and the build's messages.</shortdesc>
    </topicmeta>
    <topicref keyref="parameters"/>
    <topicref keyref="branding"/>
    <topicref keyref="custom-css"/>
    <topicref keyref="navigation"/>
    <topicref keyref="layouts"/>
    <topicref keyref="embedding"/>
    <topicref keyref="search"/>
    <topicref keyref="metadata"/>
    <topicref keyref="glossary-index"/>
    <topicref keyref="print"/>
    <topicref keyref="pdf"/>
    <topicref keyref="security"/>
    <topicref keyref="accessibility"/>
    <topicref keyref="troubleshooting"/>
    <topicref keyref="messages"/>
  </chapter>
  <chapter>
    <topicmeta>
      <navtitle>Capability demonstrations</navtitle>
      <shortdesc>Each page renders the DITA elements it describes, live.</shortdesc>
    </topicmeta>
    <topicref keyref="demo-typography"/>
    <topicref keyref="demo-notes"/>
    <topicref keyref="demo-tables"/>
    <topicref keyref="demo-code"/>
    <topicref keyref="demo-figures"/>
  </chapter>
  <chapter>
    <topicmeta>
      <navtitle>Development</navtitle>
      <shortdesc>Where the source and design records live, and how to contribute.</shortdesc>
    </topicmeta>
    <topicref keyref="development"/>
  </chapter>
  <appendix>
    <topicmeta>
      <navtitle>Licensing and legal</navtitle>
      <shortdesc>Apache-2.0 and the assets reserved for official GOV.UK services.</shortdesc>
    </topicmeta>
    <topicref keyref="legal"/>
  </appendix>
  <backmatter>
    <colophon keyref="colophon"/>
  </backmatter>
</bookmap>
