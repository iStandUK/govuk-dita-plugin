<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE map PUBLIC "-//OASIS//DTD DITA Map//EN" "map.dtd">
<!-- Page metadata (#99, design 14): the keyword filter, data terms that are
     mapped, known but unmapped, misspelt and unprefixed, and a plain map's
     own facts, and a page whose title and description hold characters a script
     element or a JSON string must escape (#100). CI builds it with and without
     govuk.site.url. -->
<map xml:lang="en-GB">
  <title>Metadata fixture</title>
  <topicmeta>
    <shortdesc>Pages whose head metadata CI checks tag by tag.</shortdesc>
  </topicmeta>
  <topicref href="topics/check.dita">
    <topicref href="topics/retired.dita"/>
  </topicref>
  <topicref href="topics/escape.dita"/>
</map>
