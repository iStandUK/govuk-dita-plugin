HTML link relations: the page's own address, its neighbours in reading order
and its licence. Every value is a URL, so nothing here is written without
govuk.site.url. The table format is described in design 14, section 7.
-->
<scheme id="links" syntax="link">
  <kind record="page">
    <property term="@id" as="canonical" format="uri" required="yes"/>
    <relation name="previous" as="prev"/>
    <relation name="next" as="next"/>
    <property term="dct:license" as="license" format="uri"/>
  </kind>
</scheme>
