Contributed to the dita.conductor.html5.param extension point: passes the
govuk.* Ant properties into the HTML5 topic transformation. The if:set guards
mean plain html5 builds (where these properties are never defined) are
unaffected.
-->
<params xmlns:if="ant:if">
  <param name="GOVUK-BRANDING" expression="${govuk.branding}" if:set="govuk.branding"/>
  <param name="GOVUK-SERVICE-NAME" expression="${govuk.service.name}" if:set="govuk.service.name"/>
  <param name="GOVUK-PHASE" expression="${govuk.phase}" if:set="govuk.phase"/>
  <param name="GOVUK-FEEDBACK-URL" expression="${govuk.feedback.url}" if:set="govuk.feedback.url"/>
  <param name="GOVUK-SERVICE-URL" expression="${govuk.service.url}" if:set="govuk.service.url"/>
  <param name="GOVUK-FAVICON" expression="${govuk.favicon.name}" if:set="govuk.favicon"/>
  <param name="GOVUK-FOOTER-LINKS" expression="${govuk.footer.links}" if:set="govuk.footer.links"/>
  <param name="GOVUK-FOOTER-LICENCE" expression="${govuk.footer.licence}" if:set="govuk.footer.licence"/>
  <param name="GOVUK-SEARCH" expression="${govuk.search.enabled}" if:set="govuk.search.enabled"/>
  <param name="GOVUK-GLOSSARY" expression="${govuk.glossary.present}" if:set="govuk.glossary.present"/>
  <param name="GOVUK-INDEX" expression="${govuk.index.present}" if:set="govuk.index.present"/>
  <param name="GOVUK-PAGINATION" expression="${govuk.pagination}" if:set="govuk.pagination"/>
  <param name="GOVUK-FIGURELIST" expression="${govuk.figurelist.present}" if:set="govuk.figurelist.present"/>
  <param name="GOVUK-TABLELIST" expression="${govuk.tablelist.present}" if:set="govuk.tablelist.present"/>
  <param name="GOVUK-SVG-INLINE" expression="${govuk.svg.inline}" if:set="govuk.svg.inline"/>
  <param name="GOVUK-PRINT" expression="${govuk.print}" if:set="govuk.print"/>
  <param name="GOVUK-SVG-SANITIZE" expression="${govuk.svg.sanitize}" if:set="govuk.svg.sanitize"/>
  <param name="GOVUK-INLINE-SCOPE" expression="${govuk.inline.scope}" if:set="govuk.inline.scope"/>
  <param name="GOVUK-INPUT-DIR" expression="${govuk.input.dir.url}" if:set="govuk.input.dir.url"/>
  <param name="GOVUK-CONTENT-WARNINGS" expression="${govuk.content.warnings}" if:set="govuk.content.warnings"/>
  <param name="GOVUK-CONTENT-POLICY" expression="${govuk.content.policy}" if:set="govuk.content.policy"/>
  <param name="GOVUK-CSP" expression="${govuk.csp}" if:set="govuk.csp"/>
  <param name="GOVUK-DATES" expression="${govuk.dates}" if:set="govuk.dates"/>
  <param name="GOVUK-PRINT-MAX-TOPICS" expression="${govuk.print.max-topics}" if:set="govuk.print.max-topics"/>
</params>
