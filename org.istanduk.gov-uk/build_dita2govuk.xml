<project name="org.istanduk.gov-uk" xmlns:if="ant:if">

  <target name="dita2govuk.init">
    <!-- Route topic rendering through this plugin's stylesheet (scoped to the
         govuk transtype; plain html5 builds are unaffected). -->
    <property name="args.xsl"
              location="${dita.plugin.org.istanduk.gov-uk.dir}/xsl/dita2govuk.xsl"/>
    <!-- The base cover step is skipped; govuk.cover re-runs the same macro with
         the plugin's parameters (layout, service name, search state). -->
    <property name="html5.toc.generate" value="false"/>
    <property name="args.html5.toc.xsl"
              location="${dita.plugin.org.istanduk.gov-uk.dir}/xsl/map2govuk-cover.xsl"/>
    <!-- The sidebar needs the full map tree on every page (FR-N1/FR-N2).
         A user-supplied nav-toc property still wins because properties are
         immutable once set. -->
    <property name="nav-toc" value="full"/>
    <!-- Previous/next pagination (FR-N5) on by default -->
    <property name="govuk.pagination" value="yes"/>
    <!-- Generate task section labels (Before you begin, Procedure, Results…)
         by default so task topics read with structure (FR-R6). -->
    <property name="args.gen.task.lbl" value="YES"/>
    <!-- Neutral branding unless the publisher explicitly opts in (FR-T1). -->
    <property name="govuk.branding" value="neutral"/>
    <fail message="govuk.branding must be 'neutral', 'istanduk', 'nhs', or 'official', was: ${govuk.branding}">
      <condition>
        <not><or>
          <equals arg1="${govuk.branding}" arg2="neutral"/>
          <equals arg1="${govuk.branding}" arg2="istanduk"/>
          <equals arg1="${govuk.branding}" arg2="nhs"/>
          <equals arg1="${govuk.branding}" arg2="official"/>
        </or></not>
      </condition>
    </fail>
    <condition property="govuk.branding.istanduk">
      <equals arg1="${govuk.branding}" arg2="istanduk"/>
    </condition>
    <condition property="govuk.branding.official">
      <equals arg1="${govuk.branding}" arg2="official"/>
    </condition>
    <echo if:set="govuk.branding.official" level="warning"
          message="govuk.branding=official: the GOV.UK crown and GDS Transport font are legally restricted to genuine GOV.UK services. Use this only for an official GOV.UK service. GDS Transport is not bundled - install the licensed font on the host or text falls back to Arial."/>
    <condition property="govuk.branding.nhs">
      <equals arg1="${govuk.branding}" arg2="nhs"/>
    </condition>
    <echo if:set="govuk.branding.nhs" level="warning"
          message="govuk.branding=nhs: the NHS identity ('NHS' letters and logo) is restricted to NHS organisations; non-NHS bodies need permission from NHS England / DHSC. Use this only for a genuine NHS service. The NHS brand font (Frutiger) is licensed to NHS organisations and is not bundled - the build falls back to Arial."/>
    <!-- Landing-page layout (D-13) -->
    <property name="govuk.homepage.layout" value="auto"/>
    <property name="govuk.homepage.depth" value="2"/>
    <fail message="govuk.homepage.depth must be a single digit 1-9, was: ${govuk.homepage.depth}">
      <condition>
        <not><matches pattern="^[1-9]$" string="${govuk.homepage.depth}"/></not>
      </condition>
    </fail>
    <fail message="govuk.homepage.layout must be one of auto|start|annotated|list|grid|grouped|accordion, was: ${govuk.homepage.layout}">
      <condition>
        <not><or>
          <equals arg1="${govuk.homepage.layout}" arg2="auto"/>
          <equals arg1="${govuk.homepage.layout}" arg2="start"/>
          <equals arg1="${govuk.homepage.layout}" arg2="annotated"/>
          <equals arg1="${govuk.homepage.layout}" arg2="list"/>
          <equals arg1="${govuk.homepage.layout}" arg2="grid"/>
          <equals arg1="${govuk.homepage.layout}" arg2="grouped"/>
          <equals arg1="${govuk.homepage.layout}" arg2="accordion"/>
        </or></not>
      </condition>
    </fail>
    <!-- Inline local SVG references natively (issue #37) unless disabled -->
    <property name="govuk.svg.inline" value="yes"/>
    <fail message="govuk.svg.inline must be 'yes' or 'no', was: ${govuk.svg.inline}">
      <condition>
        <not><or>
          <equals arg1="${govuk.svg.inline}" arg2="yes"/>
          <equals arg1="${govuk.svg.inline}" arg2="no"/>
        </or></not>
      </condition>
    </fail>
    <!-- Search (FR-S): probe for Pagefind; auto enables when found, yes
         requires it, no disables. -->
    <property name="govuk.search" value="auto"/>
    <property name="govuk.pagefind.cmd" value="pagefind"/>
    <property environment="govuk.env"/>
    <condition property="govuk.pagefind.available">
      <or>
        <available file="${govuk.pagefind.cmd}" type="file"/>
        <available file="${govuk.pagefind.cmd}" filepath="${govuk.env.PATH}"/>
        <available file="${govuk.pagefind.cmd}.exe" filepath="${govuk.env.PATH}"/>
      </or>
    </condition>
    <fail message="govuk.search=yes but the Pagefind binary was not found (govuk.pagefind.cmd=${govuk.pagefind.cmd}). Install Pagefind or set govuk.pagefind.cmd to its path; see https://pagefind.app/">
      <condition>
        <and>
          <equals arg1="${govuk.search}" arg2="yes"/>
          <not><isset property="govuk.pagefind.available"/></not>
        </and>
      </condition>
    </fail>
    <condition property="govuk.search.enabled" value="yes" else="no">
      <and>
        <not><equals arg1="${govuk.search}" arg2="no"/></not>
        <isset property="govuk.pagefind.available"/>
      </and>
    </condition>
    <condition property="govuk.search.notice"
               value="site search enabled (Pagefind found: ${govuk.pagefind.cmd})"
               else="site search disabled (govuk.search=${govuk.search}; Pagefind not found on PATH)">
      <equals arg1="${govuk.search.enabled}" arg2="yes"/>
    </condition>
    <echo level="info" message="govuk: ${govuk.search.notice}"/>
    <!-- Glossary and index (FR-G, FR-X): the pages themselves are generated by
         the cover pass from the resolved map, which knows definitively; these
         source-scan heuristics only decide whether topic sidebars link them. -->
    <dirname property="govuk.input.dir" file="${args.input}"/>
    <resourcecount property="govuk.glossary.count">
      <fileset dir="${govuk.input.dir}" includes="**/*.dita,**/*.xml">
        <contains text="glossentry"/>
      </fileset>
    </resourcecount>
    <resourcecount property="govuk.index.count">
      <fileset dir="${govuk.input.dir}" includes="**/*.dita,**/*.xml">
        <contains text="&lt;indexterm"/>
      </fileset>
    </resourcecount>
    <condition property="govuk.glossary.present" value="yes" else="no">
      <not><equals arg1="${govuk.glossary.count}" arg2="0"/></not>
    </condition>
    <condition property="govuk.index.present" value="yes" else="no">
      <not><equals arg1="${govuk.index.count}" arg2="0"/></not>
    </condition>
    <resourcecount property="govuk.figurelist.count">
      <fileset dir="${govuk.input.dir}" includes="**/*.ditamap"><contains text="&lt;figurelist"/></fileset>
    </resourcecount>
    <resourcecount property="govuk.tablelist.count">
      <fileset dir="${govuk.input.dir}" includes="**/*.ditamap"><contains text="&lt;tablelist"/></fileset>
    </resourcecount>
    <condition property="govuk.figurelist.present" value="yes" else="no">
      <not><equals arg1="${govuk.figurelist.count}" arg2="0"/></not>
    </condition>
    <condition property="govuk.tablelist.present" value="yes" else="no">
      <not><equals arg1="${govuk.tablelist.count}" arg2="0"/></not>
    </condition>
  </target>

  <target name="dita2govuk"
          depends="dita2govuk.init, dita2html5, govuk.cover, govuk.copy-assets, govuk.search-index"/>

  <target name="govuk.cover"
          description="Generate the GOV.UK home page and search page from the map">
    <html5.map>
      <param name="GOVUK-HOMEPAGE-LAYOUT" expression="${govuk.homepage.layout}"/>
      <param name="GOVUK-HOMEPAGE-DEPTH" expression="${govuk.homepage.depth}"/>
      <param name="GOVUK-SERVICE-NAME" expression="${govuk.service.name}" if:set="govuk.service.name"/>
      <param name="GOVUK-SEARCH" expression="${govuk.search.enabled}"/>
      <param name="GOVUK-BRANDING" expression="${govuk.branding}"/>
    </html5.map>
  </target>

  <target name="govuk.copy-assets"
          description="Copy GOV.UK frontend assets and plugin CSS into the output">
    <!-- Neutral builds deliberately ship no GDS Transport fonts and no crown
         imagery (FR-T1); official-mode asset handling is tracked separately. -->
    <copy todir="${dita.output.dir}/govuk">
      <fileset dir="${dita.plugin.org.istanduk.gov-uk.dir}/resource/govuk-frontend">
        <include name="*.min.css"/>
        <include name="*.min.js"/>
        <include name="*.map"/>
        <include name="VERSION.txt"/>
      </fileset>
      <fileset dir="${dita.plugin.org.istanduk.gov-uk.dir}/resource/css">
        <include name="*.css"/>
      </fileset>
      <fileset dir="${dita.plugin.org.istanduk.gov-uk.dir}/resource/js">
        <include name="*.js"/>
      </fileset>
    </copy>
    <!-- Theme assets (safe to redistribute: outlined-path artwork, see
         resource/brand/istanduk/README.md) -->
    <copy if:set="govuk.branding.istanduk" todir="${dita.output.dir}/govuk">
      <fileset dir="${dita.plugin.org.istanduk.gov-uk.dir}/resource/brand/istanduk">
        <include name="*.svg"/>
      </fileset>
    </copy>
    <!-- The inherited html5.css step copies the default stylesheets, but no
         govuk page links them; drop the dead files -->
    <delete file="${dita.output.dir}/commonltr.css" quiet="true"/>
    <delete file="${dita.output.dir}/commonrtl.css" quiet="true"/>
  </target>

  <target name="govuk.search-index"
          description="Index the generated site with Pagefind (FR-S1)">
    <local name="govuk.search.on"/>
    <condition property="govuk.search.on">
      <equals arg1="${govuk.search.enabled}" arg2="yes"/>
    </condition>
    <exec if:set="govuk.search.on" executable="${govuk.pagefind.cmd}" failonerror="true">
      <arg value="--site"/>
      <arg value="${dita.output.dir}"/>
    </exec>
  </target>

</project>
