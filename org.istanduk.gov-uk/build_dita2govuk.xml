<project name="org.istanduk.gov-uk" xmlns:if="ant:if" xmlns:unless="ant:unless">

  <target name="dita2govuk.init">
    <!-- Route topic rendering through this plugin's stylesheet (scoped to the
         govuk transtype; plain html5 builds are unaffected). -->
    <property name="args.xsl"
              location="${dita.plugin.org.istanduk.gov-uk.dir}/xsl/dita2govuk.xsl"/>
    <!-- The base cover step is skipped; govuk.cover re-runs the same macro with
         the plugin's parameters (layout, service name, search state). -->
    <property name="html5.toc.generate" value="false"/>
    <property name="args.html5.toc.xsl"
              location="${dita.plugin.org.istanduk.gov-uk.dir}/xsl/map2govuk-cover.xsl"/>
    <!-- The sidebar needs the full map tree on every page (FR-N1/FR-N2).
         A user-supplied nav-toc property still wins because properties are
         immutable once set. -->
    <property name="nav-toc" value="full"/>
    <!-- Previous/next pagination (FR-N5) on by default -->
    <property name="govuk.pagination" value="yes"/>
    <!-- Generate task section labels (Before you begin, Procedure, Results…)
         by default so task topics read with structure (FR-R6). -->
    <property name="args.gen.task.lbl" value="YES"/>
    <!-- Neutral branding unless the publisher explicitly opts in (FR-T1). -->
    <property name="govuk.branding" value="neutral"/>
    <fail message="govuk.branding must be 'neutral', 'istanduk', 'nhs', or 'official', was: ${govuk.branding}">
      <condition>
        <not><or>
          <equals arg1="${govuk.branding}" arg2="neutral"/>
          <equals arg1="${govuk.branding}" arg2="istanduk"/>
          <equals arg1="${govuk.branding}" arg2="nhs"/>
          <equals arg1="${govuk.branding}" arg2="official"/>
        </or></not>
      </condition>
    </fail>
    <condition property="govuk.branding.istanduk">
      <equals arg1="${govuk.branding}" arg2="istanduk"/>
    </condition>
    <condition property="govuk.branding.official">
      <equals arg1="${govuk.branding}" arg2="official"/>
    </condition>
    <echo if:set="govuk.branding.official" level="warning"
          message="govuk.branding=official: the GOV.UK crown and GDS Transport font are legally restricted to genuine GOV.UK services. Use this only for an official GOV.UK service. GDS Transport is not bundled - install the licensed font on the host or text falls back to Arial."/>
    <condition property="govuk.branding.nhs">
      <equals arg1="${govuk.branding}" arg2="nhs"/>
    </condition>
    <echo if:set="govuk.branding.nhs" level="warning"
          message="govuk.branding=nhs: the NHS identity ('NHS' letters and logo) is restricted to NHS organisations; non-NHS bodies need permission from NHS England / DHSC. Use this only for a genuine NHS service. The NHS brand font (Frutiger) is licensed to NHS organisations and is not bundled - the build falls back to Arial."/>
    <!-- Landing-page layout (D-13) -->
    <property name="govuk.homepage.layout" value="auto"/>
    <property name="govuk.homepage.depth" value="2"/>
    <fail message="govuk.homepage.depth must be a single digit 1-9, was: ${govuk.homepage.depth}">
      <condition>
        <not><matches pattern="^[1-9]$" string="${govuk.homepage.depth}"/></not>
      </condition>
    </fail>
    <fail message="govuk.homepage.layout must be one of auto|start|annotated|list|grid|grouped|accordion, was: ${govuk.homepage.layout}">
      <condition>
        <not><or>
          <equals arg1="${govuk.homepage.layout}" arg2="auto"/>
          <equals arg1="${govuk.homepage.layout}" arg2="start"/>
          <equals arg1="${govuk.homepage.layout}" arg2="annotated"/>
          <equals arg1="${govuk.homepage.layout}" arg2="list"/>
          <equals arg1="${govuk.homepage.layout}" arg2="grid"/>
          <equals arg1="${govuk.homepage.layout}" arg2="grouped"/>
          <equals arg1="${govuk.homepage.layout}" arg2="accordion"/>
        </or></not>
      </condition>
    </fail>
    <!-- Publisher favicon (FR-T3): the basename is passed to the XSLT for the
         head link; the file itself is copied by govuk.copy-assets. -->
    <basename property="govuk.favicon.name" file="${govuk.favicon}" if:set="govuk.favicon"/>
    <!-- Inline local SVG references natively (issue #37) unless disabled -->
    <property name="govuk.svg.inline" value="yes"/>
    <fail message="govuk.svg.inline must be 'yes' or 'no', was: ${govuk.svg.inline}">
      <condition>
        <not><or>
          <equals arg1="${govuk.svg.inline}" arg2="yes"/>
          <equals arg1="${govuk.svg.inline}" arg2="no"/>
        </or></not>
      </condition>
    </fail>
    <!-- Search (FR-S): probe for Pagefind; auto enables when found, yes
         requires it, no disables. -->
    <property name="govuk.search" value="auto"/>
    <property name="govuk.pagefind.cmd" value="pagefind"/>
    <property name="govuk.search.ranking" value="default"/>
    <fail message="govuk.search.ranking must be 'default', 'reference' or a JSON object such as {&quot;termFrequency&quot;:0,&quot;pageLength&quot;:0}, was: ${govuk.search.ranking}">
      <condition>
        <not><or>
          <equals arg1="${govuk.search.ranking}" arg2="default"/>
          <equals arg1="${govuk.search.ranking}" arg2="reference"/>
          <matches string="${govuk.search.ranking}" pattern="^\s*\{.*\}\s*$"/>
        </or></not>
      </condition>
    </fail>
    <property environment="govuk.env"/>
    <condition property="govuk.pagefind.available">
      <or>
        <available file="${govuk.pagefind.cmd}" type="file"/>
        <available file="${govuk.pagefind.cmd}" filepath="${govuk.env.PATH}"/>
        <available file="${govuk.pagefind.cmd}.exe" filepath="${govuk.env.PATH}"/>
      </or>
    </condition>
    <fail message="govuk.search=yes but the Pagefind binary was not found (govuk.pagefind.cmd=${govuk.pagefind.cmd}). Install Pagefind or set govuk.pagefind.cmd to its path; see https://pagefind.app/">
      <condition>
        <and>
          <equals arg1="${govuk.search}" arg2="yes"/>
          <not><isset property="govuk.pagefind.available"/></not>
        </and>
      </condition>
    </fail>
    <condition property="govuk.search.enabled" value="yes" else="no">
      <and>
        <not><equals arg1="${govuk.search}" arg2="no"/></not>
        <isset property="govuk.pagefind.available"/>
      </and>
    </condition>
    <condition property="govuk.search.notice"
               value="site search enabled (Pagefind found: ${govuk.pagefind.cmd})"
               else="site search disabled (govuk.search=${govuk.search}; Pagefind not found on PATH)">
      <equals arg1="${govuk.search.enabled}" arg2="yes"/>
    </condition>
    <echo level="info" message="govuk: ${govuk.search.notice}"/>
    <!-- Glossary and index (FR-G, FR-X): the pages themselves are generated by
         the cover pass from the resolved map, which knows definitively; these
         source-scan heuristics only decide whether topic sidebars link them. -->
    <dirname property="govuk.input.dir" file="${args.input}"/>
    <resourcecount property="govuk.glossary.count">
      <fileset dir="${govuk.input.dir}" includes="**/*.dita,**/*.xml">
        <contains text="glossentry"/>
      </fileset>
    </resourcecount>
    <resourcecount property="govuk.index.count">
      <fileset dir="${govuk.input.dir}" includes="**/*.dita,**/*.xml">
        <contains text="&lt;indexterm"/>
      </fileset>
    </resourcecount>
    <condition property="govuk.glossary.present" value="yes" else="no">
      <not><equals arg1="${govuk.glossary.count}" arg2="0"/></not>
    </condition>
    <condition property="govuk.index.present" value="yes" else="no">
      <not><equals arg1="${govuk.index.count}" arg2="0"/></not>
    </condition>
    <resourcecount property="govuk.figurelist.count">
      <fileset dir="${govuk.input.dir}" includes="**/*.ditamap"><contains text="&lt;figurelist"/></fileset>
    </resourcecount>
    <resourcecount property="govuk.tablelist.count">
      <fileset dir="${govuk.input.dir}" includes="**/*.ditamap"><contains text="&lt;tablelist"/></fileset>
    </resourcecount>
    <condition property="govuk.figurelist.present" value="yes" else="no">
      <not><equals arg1="${govuk.figurelist.count}" arg2="0"/></not>
    </condition>
    <condition property="govuk.tablelist.present" value="yes" else="no">
      <not><equals arg1="${govuk.tablelist.count}" arg2="0"/></not>
    </condition>
    <!-- Print stylesheet and print document (FR-P1/FR-P2, D-20, #63) -->
    <property name="govuk.print" value="no"/>
    <fail message="govuk.print must be 'yes' or 'no', was: ${govuk.print}">
      <condition>
        <not><or>
          <equals arg1="${govuk.print}" arg2="yes"/>
          <equals arg1="${govuk.print}" arg2="no"/>
        </or></not>
      </condition>
    </fail>
    <condition property="govuk.print.on">
      <equals arg1="${govuk.print}" arg2="yes"/>
    </condition>
    <property name="govuk.print.max-topics" value="500"/>
    <fail message="govuk.print.max-topics must be a whole number, was: ${govuk.print.max-topics}">
      <condition>
        <not><matches pattern="^[0-9]+$" string="${govuk.print.max-topics}"/></not>
      </condition>
    </fail>
    <property name="govuk.print.toc.depth" value="3"/>
    <fail message="govuk.print.toc.depth must be a single digit 1-9, was: ${govuk.print.toc.depth}">
      <condition>
        <not><matches pattern="^[1-9]$" string="${govuk.print.toc.depth}"/></not>
      </condition>
    </fail>
    <!-- Paper for print.css (and, in 1.1, the PDF engine): a CSS page-size
         keyword, or a width and height as CSS lengths -->
    <property name="govuk.pdf.paper" value="A4"/>
    <fail message="govuk.pdf.paper must be one of A5, A4, A3, B5, B4, JIS-B5, JIS-B4, Letter, Legal, Ledger, or a width and height such as '210mm 297mm', was: ${govuk.pdf.paper}">
      <condition>
        <not><or>
          <matches pattern="^(A5|A4|A3|B5|B4|JIS-B5|JIS-B4|letter|legal|ledger)$" string="${govuk.pdf.paper}" casesensitive="false"/>
          <matches pattern="^[0-9]+(\.[0-9]+)?(mm|cm|in|pt|pc|px) [0-9]+(\.[0-9]+)?(mm|cm|in|pt|pc|px)$" string="${govuk.pdf.paper}"/>
        </or></not>
      </condition>
    </fail>
    <property name="govuk.pdf.orientation" value="portrait"/>
    <fail message="govuk.pdf.orientation must be 'portrait' or 'landscape', was: ${govuk.pdf.orientation}">
      <condition>
        <not><or>
          <equals arg1="${govuk.pdf.orientation}" arg2="portrait"/>
          <equals arg1="${govuk.pdf.orientation}" arg2="landscape"/>
        </or></not>
      </condition>
    </fail>
    <!-- An external CSS Paged Media formatter for the print document (#106).
         The plugin bundles none and downloads nothing: the publisher names a
         command they have installed. -->
    <property name="govuk.pdf.command" value=""/>
    <!-- the shell that runs it, so a publisher's command may carry its own
         arguments and quoting -->
    <condition property="govuk.pdf.shell" value="cmd.exe" else="/bin/sh">
      <os family="windows"/>
    </condition>
    <condition property="govuk.pdf.shell.flag" value="/c" else="-c">
      <os family="windows"/>
    </condition>
    <condition property="govuk.pdf.on">
      <and>
        <not><equals arg1="${govuk.pdf.command}" arg2=""/></not>
        <equals arg1="${govuk.print}" arg2="yes"/>
      </and>
    </condition>
    <condition property="govuk.pdf.without.print">
      <and>
        <not><equals arg1="${govuk.pdf.command}" arg2=""/></not>
        <not><equals arg1="${govuk.print}" arg2="yes"/></not>
      </and>
    </condition>
    <echo if:set="govuk.pdf.without.print" level="warning"
          message="[GOVK008W]: govuk.pdf.command is set but govuk.print is not 'yes', so there is no print document to render. Set govuk.print=yes."/>
    <basename property="govuk.pdf.default.name" file="${args.input}" suffix=".ditamap"/>
    <property name="govuk.pdf.name" value="${govuk.pdf.default.name}"/>
    <!-- CSS takes the orientation keyword only with a named size; explicit
         lengths are already width then height -->
    <condition property="govuk.print.page-size"
               value="${govuk.pdf.paper} ${govuk.pdf.orientation}" else="${govuk.pdf.paper}">
      <matches pattern="^[A-Za-z]" string="${govuk.pdf.paper}"/>
    </condition>
    <!-- Content reaching readers (epic #77): every behaviour is the publisher's
         choice and every finding is a warning, never a failed build. -->
    <property name="govuk.svg.sanitize" value="yes"/>
    <fail message="govuk.svg.sanitize must be 'yes' or 'no', was: ${govuk.svg.sanitize}">
      <condition><not><or>
        <equals arg1="${govuk.svg.sanitize}" arg2="yes"/>
        <equals arg1="${govuk.svg.sanitize}" arg2="no"/>
      </or></not></condition>
    </fail>
    <property name="govuk.inline.scope" value="input"/>
    <fail message="govuk.inline.scope must be 'input' or 'any', was: ${govuk.inline.scope}">
      <condition><not><or>
        <equals arg1="${govuk.inline.scope}" arg2="input"/>
        <equals arg1="${govuk.inline.scope}" arg2="any"/>
      </or></not></condition>
    </fail>
    <!-- the input directory as a URL, for the scope check -->
    <makeurl property="govuk.input.dir.url" file="${govuk.input.dir}"/>
    <property name="govuk.content.warnings" value="yes"/>
    <fail message="govuk.content.warnings must be 'yes' or 'no', was: ${govuk.content.warnings}">
      <condition><not><or>
        <equals arg1="${govuk.content.warnings}" arg2="yes"/>
        <equals arg1="${govuk.content.warnings}" arg2="no"/>
      </or></not></condition>
    </fail>
    <property name="govuk.content.policy" value="warn"/>
    <fail message="govuk.content.policy must be 'warn' or 'strip', was: ${govuk.content.policy}">
      <condition><not><or>
        <equals arg1="${govuk.content.policy}" arg2="warn"/>
        <equals arg1="${govuk.content.policy}" arg2="strip"/>
      </or></not></condition>
    </fail>
    <!-- Content-Security-Policy: no | meta | a literal policy (directive list) -->
    <property name="govuk.csp" value="no"/>
    <fail message="govuk.csp must be 'no', 'meta' or a Content-Security-Policy directive list such as &quot;default-src 'self'&quot;, was: ${govuk.csp}">
      <condition><not><or>
        <equals arg1="${govuk.csp}" arg2="no"/>
        <equals arg1="${govuk.csp}" arg2="meta"/>
        <matches pattern="^\s*[a-z-]+-src\s" string="${govuk.csp}"/>
        <matches pattern="^\s*(default-src|base-uri|form-action|sandbox|upgrade-insecure-requests|require-trusted-types-for|trusted-types|report-to)\b" string="${govuk.csp}"/>
      </or></not></condition>
    </fail>
    <!-- Topic dates: no | updated | both -->
    <property name="govuk.dates" value="no"/>
    <fail message="govuk.dates must be 'no', 'updated' or 'both', was: ${govuk.dates}">
      <condition><not><or>
        <equals arg1="${govuk.dates}" arg2="no"/>
        <equals arg1="${govuk.dates}" arg2="updated"/>
        <equals arg1="${govuk.dates}" arg2="both"/>
      </or></not></condition>
    </fail>
    <!-- sitemap.xml: auto writes it when the site's base URL is known -->
    <property name="govuk.sitemap" value="auto"/>
    <fail message="govuk.sitemap must be 'auto', 'yes' or 'no', was: ${govuk.sitemap}">
      <condition><not><or>
        <equals arg1="${govuk.sitemap}" arg2="auto"/>
        <equals arg1="${govuk.sitemap}" arg2="yes"/>
        <equals arg1="${govuk.sitemap}" arg2="no"/>
      </or></not></condition>
    </fail>
    <condition property="govuk.site.url.set">
      <and>
        <isset property="govuk.site.url"/>
        <not><equals arg1="${govuk.site.url}" arg2=""/></not>
      </and>
    </condition>
    <condition property="govuk.site.url.bad">
      <and>
        <isset property="govuk.site.url.set"/>
        <not><matches pattern="^https?://[^\s]+$" string="${govuk.site.url}"/></not>
      </and>
    </condition>
    <fail if="govuk.site.url.bad" message="govuk.site.url must be an absolute http(s) URL, was: ${govuk.site.url}"/>
    <fail message="govuk.sitemap=yes needs govuk.site.url (the published base URL) for absolute sitemap entries">
      <condition>
        <and>
          <equals arg1="${govuk.sitemap}" arg2="yes"/>
          <not><isset property="govuk.site.url.set"/></not>
        </and>
      </condition>
    </fail>
    <condition property="govuk.sitemap.enabled" value="yes" else="no">
      <and>
        <not><equals arg1="${govuk.sitemap}" arg2="no"/></not>
        <isset property="govuk.site.url.set"/>
      </and>
    </condition>
    <condition property="govuk.sitemap.on">
      <equals arg1="${govuk.sitemap.enabled}" arg2="yes"/>
    </condition>
    <condition property="govuk.site.url.slash" value="${govuk.site.url}" else="${govuk.site.url}/">
      <matches pattern="/$" string="${govuk.site.url}"/>
    </condition>
    <echo level="info" unless:set="govuk.sitemap.on"
          message="govuk: sitemap.xml not written (govuk.sitemap=${govuk.sitemap}; set govuk.site.url to the published base URL to generate one)"/>
    <!-- the vendored govuk-frontend version, for init.js -->
    <loadfile property="govuk.frontend.version"
              srcfile="${dita.plugin.org.istanduk.gov-uk.dir}/resource/govuk-frontend/VERSION.txt">
      <filterchain><striplinebreaks/></filterchain>
    </loadfile>
  </target>

  <target name="dita2govuk"
          depends="dita2govuk.init, dita2html5, govuk.cover, govuk.print, govuk.copy-assets, govuk.search-index, govuk.pdf"/>

  <target name="govuk.cover"
          description="Generate the GOV.UK home page and search page from the map">
    <html5.map>
      <param name="GOVUK-HOMEPAGE-LAYOUT" expression="${govuk.homepage.layout}"/>
      <param name="GOVUK-HOMEPAGE-DEPTH" expression="${govuk.homepage.depth}"/>
      <param name="GOVUK-SERVICE-NAME" expression="${govuk.service.name}" if:set="govuk.service.name"/>
      <param name="GOVUK-SEARCH" expression="${govuk.search.enabled}"/>
      <param name="GOVUK-SEARCH-RANKING" expression="${govuk.search.ranking}"/>
      <param name="GOVUK-BRANDING" expression="${govuk.branding}"/>
      <param name="GOVUK-PHASE" expression="${govuk.phase}" if:set="govuk.phase"/>
      <param name="GOVUK-FEEDBACK-URL" expression="${govuk.feedback.url}" if:set="govuk.feedback.url"/>
      <param name="GOVUK-SERVICE-URL" expression="${govuk.service.url}" if:set="govuk.service.url"/>
      <param name="GOVUK-FAVICON" expression="${govuk.favicon.name}" if:set="govuk.favicon"/>
      <param name="GOVUK-FOOTER-LINKS" expression="${govuk.footer.links}" if:set="govuk.footer.links"/>
      <param name="GOVUK-FOOTER-LICENCE" expression="${govuk.footer.licence}" if:set="govuk.footer.licence"/>
      <param name="GOVUK-PRINT" expression="${govuk.print}"/>
      <param name="GOVUK-PRINT-MAX-TOPICS" expression="${govuk.print.max-topics}"/>
      <param name="GOVUK-CSP" expression="${govuk.csp}"/>
      <param name="GOVUK-SITEMAP" expression="${govuk.sitemap.enabled}"/>
      <param name="GOVUK-SITE-URL" expression="${govuk.site.url}" if:set="govuk.site.url.set"/>
      <param name="GOVUK-DATES" expression="${govuk.dates}"/>
    </html5.map>
    <!-- robots.txt beside the sitemap, unless the publisher ships one (#60) -->
    <local name="govuk.robots.exists"/>
    <available property="govuk.robots.exists" file="${dita.output.dir}/robots.txt"/>
    <echo if:set="govuk.sitemap.on" unless:set="govuk.robots.exists"
          file="${dita.output.dir}/robots.txt">User-agent: *
Allow: /
Sitemap: ${govuk.site.url.slash}sitemap.xml
</echo>
  </target>

  <!-- The same map transformation as the cover, with the topic-rendering
       stylesheets loaded, whose output is the one-file print document. Runs
       only when asked, so ordinary builds render each topic once. -->
  <target name="govuk.print" if="govuk.print.on"
          description="Write the whole publication as one print document, print.html (FR-P2)">
    <local name="govuk.print.output.dir"/>
    <condition property="govuk.print.output.dir" value="${dita.output.dir}" else="${_dita.map.output.dir}">
      <isset property="inner.transform"/>
    </condition>
    <pipeline message="Convert DITA map to print document" taskname="xslt">
      <xslt destdir="${govuk.print.output.dir}"
            style="${dita.plugin.org.istanduk.gov-uk.dir}/xsl/map2govuk-print.xsl">
        <ditafileset input="true" format="ditamap"/>
        <param name="FILTERFILE" expression="${dita.input.valfile.url}" if:set="dita.input.valfile"/>
        <param name="OUTEXT" expression="${out.ext}" if:set="out.ext"/>
        <param name="CSS" expression="${args.css.file}" if:set="args.css.file"/>
        <param name="CSSPATH" expression="${user.csspath}" if:set="user.csspath"/>
        <param name="GOVUK-SERVICE-NAME" expression="${govuk.service.name}" if:set="govuk.service.name"/>
        <param name="GOVUK-SEARCH" expression="${govuk.search.enabled}"/>
        <param name="GOVUK-BRANDING" expression="${govuk.branding}"/>
        <param name="GOVUK-FAVICON" expression="${govuk.favicon.name}" if:set="govuk.favicon"/>
        <param name="GOVUK-SVG-INLINE" expression="${govuk.svg.inline}"/>
        <param name="GOVUK-PRINT" expression="${govuk.print}"/>
        <param name="GOVUK-PRINT-MAX-TOPICS" expression="${govuk.print.max-topics}"/>
        <param name="GOVUK-PRINT-TOC-DEPTH" expression="${govuk.print.toc.depth}"/>
        <param name="GOVUK-SVG-SANITIZE" expression="${govuk.svg.sanitize}"/>
        <param name="GOVUK-INLINE-SCOPE" expression="${govuk.inline.scope}"/>
        <param name="GOVUK-INPUT-DIR" expression="${govuk.input.dir.url}"/>
        <param name="GOVUK-CONTENT-WARNINGS" expression="${govuk.content.warnings}"/>
        <param name="GOVUK-CONTENT-POLICY" expression="${govuk.content.policy}"/>
        <param name="GOVUK-CSP" expression="${govuk.csp}"/>
        <param name="GOVUK-DATES" expression="${govuk.dates}"/>
        <mapper type="merge" to="print.html"/>
        <xmlcatalog refid="dita.catalog"/>
      </xslt>
    </pipeline>
    <!-- Above govuk.print.max-topics the transform writes nothing (GOVK003I) -->
    <delete>
      <fileset dir="${govuk.print.output.dir}" includes="print.html">
        <size value="0" when="equal"/>
      </fileset>
    </delete>
  </target>

  <!-- Render the print document with the publisher's own CSS Paged Media
       formatter (#106, D-23 option A). Runs after the assets are in place, so
       the formatter sees the stylesheets; failure is a warning, never a failed
       build — the site is complete without the PDF. -->
  <target name="govuk.pdf" if="govuk.pdf.on" depends="govuk.copy-assets"
          description="Render print.html as PDF with an external formatter (govuk.pdf.command)">
    <local name="govuk.pdf.in"/><local name="govuk.pdf.out"/>
    <local name="govuk.pdf.rc"/><local name="govuk.pdf.missing"/>
    <property name="govuk.pdf.in" location="${dita.output.dir}/print.html"/>
    <property name="govuk.pdf.out" location="${dita.output.dir}/${govuk.pdf.name}.pdf"/>
    <available property="govuk.pdf.missing" file="${govuk.pdf.in}" type="file"/>
    <echo unless:set="govuk.pdf.missing" level="warning"
          message="[GOVK008W]: no print document to render at ${govuk.pdf.in} (govuk.print.max-topics may have skipped it); govuk.pdf.command not run."/>
    <sequential if:set="govuk.pdf.missing">
      <echo level="info" message="govuk: rendering ${govuk.pdf.in} with: ${govuk.pdf.command}"/>
      <exec executable="${govuk.pdf.shell}" resultproperty="govuk.pdf.rc" failonerror="false"
            dir="${dita.output.dir}">
        <arg value="${govuk.pdf.shell.flag}"/>
        <arg value="${govuk.pdf.command} &quot;${govuk.pdf.in}&quot; &quot;${govuk.pdf.out}&quot;"/>
      </exec>
      <condition property="govuk.pdf.failed">
        <not><equals arg1="${govuk.pdf.rc}" arg2="0"/></not>
      </condition>
      <echo if:set="govuk.pdf.failed" level="warning"
            message="[GOVK008W]: the PDF command exited ${govuk.pdf.rc}; the site is complete but no PDF was produced. Command: ${govuk.pdf.command}"/>
      <echo unless:set="govuk.pdf.failed" level="info"
            message="govuk: PDF written to ${govuk.pdf.out}"/>
    </sequential>
  </target>

  <target name="govuk.copy-assets"
          description="Copy GOV.UK frontend assets and plugin CSS into the output">
    <!-- Neutral builds deliberately ship no GDS Transport fonts and no crown
         imagery (FR-T1); official-mode asset handling is tracked separately. -->
    <copy todir="${dita.output.dir}/govuk">
      <fileset dir="${dita.plugin.org.istanduk.gov-uk.dir}/resource/govuk-frontend">
        <include name="*.min.css"/>
        <include name="*.min.js"/>
        <include name="*.map"/>
        <include name="VERSION.txt"/>
      </fileset>
      <fileset dir="${dita.plugin.org.istanduk.gov-uk.dir}/resource/css">
        <include name="*.css"/>
        <exclude name="print.css"/>
      </fileset>
      <fileset dir="${dita.plugin.org.istanduk.gov-uk.dir}/resource/js">
        <include name="*.js"/>
        <exclude name="init.js"/>
      </fileset>
    </copy>
    <!-- govuk-frontend initialiser: the bundle's version is filled in (#79) -->
    <copy file="${dita.plugin.org.istanduk.gov-uk.dir}/resource/js/init.js"
          todir="${dita.output.dir}/govuk" overwrite="true">
      <filterset>
        <filter token="GOVUK_FRONTEND_VERSION" value="${govuk.frontend.version}"/>
      </filterset>
    </copy>
    <!-- Print stylesheet (FR-P1): the page size is filled in from the paper
         parameters at copy time -->
    <copy file="${dita.plugin.org.istanduk.gov-uk.dir}/resource/css/print.css"
          todir="${dita.output.dir}/govuk" overwrite="true">
      <filterset>
        <filter token="GOVUK_PAGE_SIZE" value="${govuk.print.page-size}"/>
      </filterset>
    </copy>
    <!-- Publisher favicon (FR-T3): copied next to the CSS, linked by its basename -->
    <copy file="${govuk.favicon}" todir="${dita.output.dir}/govuk" if:set="govuk.favicon"/>
    <!-- Theme assets (safe to redistribute: outlined-path artwork, see
         resource/brand/istanduk/README.md) -->
    <copy if:set="govuk.branding.istanduk" todir="${dita.output.dir}/govuk">
      <fileset dir="${dita.plugin.org.istanduk.gov-uk.dir}/resource/brand/istanduk">
        <include name="*.svg"/>
      </fileset>
    </copy>
    <!-- The inherited html5.css step copies the default stylesheets, but no
         govuk page links them; drop the dead files -->
    <delete file="${dita.output.dir}/commonltr.css" quiet="true"/>
    <delete file="${dita.output.dir}/commonrtl.css" quiet="true"/>
  </target>

  <target name="govuk.search-index"
          description="Index the generated site with Pagefind (FR-S1)">
    <local name="govuk.search.on"/>
    <condition property="govuk.search.on">
      <equals arg1="${govuk.search.enabled}" arg2="yes"/>
    </condition>
    <exec if:set="govuk.search.on" executable="${govuk.pagefind.cmd}" failonerror="true">
      <arg value="--site"/>
      <arg value="${dita.output.dir}"/>
    </exec>
  </target>

</project>
